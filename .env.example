# ==========================================
# Cloudflare Turnstile (required for contact-form submissions)
# ==========================================
# Create a Managed widget at https://dash.cloudflare.com/?to=/:account/turnstile
# Public widget key. Next.js exposes this value to the browser through next.config.mjs.
TURNSTILE_SITE_KEY=your_turnstile_site_key
# Server-only: never expose this value in client code.
TURNSTILE_SECRET_KEY=your_turnstile_secret_key

# ==========================================
# Email / SMTP Configuration
# ==========================================
# Destination email address where all portfolio contact messages will be received
CONTACT_DESTINATION_EMAIL=mayankpadhi91@gmail.com

# SMTP Server Credentials (e.g. Gmail, Outlook, AWS SES, Mailgun, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
SMTP_FROM="Mayank Padhi Portfolio <your_email@gmail.com>"

# Optional: Resend API Key fallback
# RESEND_API_KEY=re_xxxxxxxxxxxx
